CREATE TABLE payment_option (
    referenceSlug   TEXT NOT NULL,
    nameKey         TEXT NOT NULL,
    noteKey         TEXT,
    icon            TEXT,

    PRIMARY KEY (referenceSlug, nameKey, noteKey),
    FOREIGN KEY(nameKey) REFERENCES localized_string(key),
    FOREIGN KEY(noteKey) REFERENCES localized_string(key)
);

insert:
INSERT INTO payment_option
VALUES ?;

clear:
DELETE FROM payment_option;