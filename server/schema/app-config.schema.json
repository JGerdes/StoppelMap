{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdn.stoppelmap.de/app-config.schema.json",
  "title": "StoppelMap App configuration",
  "description": "Configuration of StoppelMap mobile App",
  "type": "object",
  "properties": {
    "supportedVersions": {
      "type": "object",
      "properties": {
        "android": {
          "type": "object",
          "properties": {
            "oldest": {
              "type": "number",
              "minimum": 230000000,
              "maximum": 500000000
            }
          },
          "required": [
            "oldest"
          ],
          "additionalProperties": false
        },
        "iOS": {
          "type": "object",
          "properties": {
            "oldest": {
              "type": "number",
              "minimum": 230000000,
              "maximum": 500000000
            }
          },
          "required": [
            "oldest"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "android",
        "iOS"
      ],
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "latest": {
          "type": "object",
          "properties": {
            "version": {
              "type": "number"
            },
            "file": {
              "type": "string"
            },
            "supportedSince": {
              "type": "object",
              "properties": {
                "android": {
                  "type": "number",
                  "minimum": 230000000,
                  "maximum": 500000000
                },
                "iOS": {
                  "type": "number",
                  "minimum": 230000000,
                  "maximum": 500000000
                }
              },
              "required": [
                "android",
                "iOS"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "version",
            "file",
            "supportedSince"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "latest"
      ],
      "additionalProperties": false
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "minimum": 230000000,
            "maximum": 500000000
          },
          "platform": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "android",
                "iOS"
              ]
            }
          },
          "message": {
            "type": "object",
            "properties": {
              "title": {
                "type": "object",
                "properties": {
                  "de": {
                    "type": "string"
                  }
                },
                "required": [
                  "de"
                ]
              },
              "content": {
                "type": "object",
                "properties": {
                  "de": {
                    "type": "string"
                  }
                },
                "required": [
                  "de"
                ]
              },
              "type": {
                "type": "string",
                "enum": [
                  "info",
                  "warning"
                ]
              },
              "buttons": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "object",
                      "properties": {
                        "de": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "de"
                      ]
                    },
                    "url": {
                      "type": "object",
                      "properties": {
                        "de": {
                          "type": "string",
                          "format": "uri"
                        }
                      },
                      "required": [
                        "de"
                      ]
                    }
                  },
                  "required": [
                    "title",
                    "url"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "title",
              "content"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "minimum": 230000000,
            "maximum": 500000000
          },
          "platform": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "android",
                "iOS"
              ]
            }
          },
          "notice": {
            "type": "object",
            "properties": {
              "title": {
                "type": "object",
                "properties": {
                  "de": {
                    "type": "string"
                  }
                },
                "required": [
                  "de"
                ]
              },
              "content": {
                "type": "object",
                "properties": {
                  "de": {
                    "type": "string"
                  }
                },
                "required": [
                  "de"
                ]
              },
              "type": {
                "type": "string",
                "enum": [
                  "info",
                  "warning"
                ]
              }
            },
            "required": [
              "title",
              "content"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "notice"
        ],
        "additionalProperties": false
      }
    },
    "homeCards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "object",
            "properties": {
              "platform": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "android",
                    "iOS"
                  ]
                }
              },
              "version": {
                "type": "integer",
                "minimum": 230000000,
                "maximum": 500000000
              },
              "minVersion": {
                "type": "integer",
                "minimum": 230000000,
                "maximum": 500000000
              },
              "maxVersion": {
                "type": "integer",
                "minimum": 230000000,
                "maximum": 500000000
              }
            },
            "additionalProperties": false,
            "minProperties": 1
          }
        },
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "content"
              },
              "headerImage": {
                "url": "string",
                "pattern": "https?://.+"
              },
              "headerImageDark": {
                "url": "string",
                "pattern": "https?://.+"
              },
              "title": {
                "type": "object",
                "patternProperties": {
                  "^\\w{2}$": {
                    "type": "string"
                  }
                },
                "required": [
                  "de"
                ]
              },
              "text": {
                "type": "object",
                "patternProperties": {
                  "^\\w{2}$": {
                    "type": "string"
                  }
                },
                "required": [
                  "de"
                ]
              },
              "buttons": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "icon": {
                      "type": "string",
                      "enum": [
                        "Phone",
                        "Insta",
                        "Bsky",
                        "Masto",
                        "GHub"
                      ]
                    },
                    "label": {
                      "type": "object",
                      "patternProperties": {
                        "^\\w{2}$": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "de"
                      ]
                    },
                    "action": {
                      "type": "object",
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "call_phone_number"
                            },
                            "phoneNumber": {
                              "type": "string",
                              "pattern": "\\+\\d+"
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "type",
                            "phoneNumber"
                          ]
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "open_url"
                            },
                            "url": {
                              "type": "object",
                              "patternProperties": {
                                "^\\w{2}$": {
                                  "type": "string",
                                  "pattern": "https?://.+"
                                }
                              },
                              "required": [
                                "de"
                              ]
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "type",
                            "url"
                          ]
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "send_feedback"
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "type"
                          ]
                        }
                      ]
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "Primary",
                        "Secondary"
                      ]
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "action"
                  ]
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "type"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "supportedVersions",
    "data",
    "messages",
    "homeCards"
  ],
  "additionalProperties": false
}
